{
  "manifest_version": 3,
  "name": "StackLens - Web Tech Detector",
  "version": "1.1.0",
  "description": "Instantly reveals the frameworks, CMS, libraries, analytics, and tech stack powering any website.",
  "author": "SkdSam",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Inspect Tech Stack"
  },
  "permissions": [
    "scripting",
    "webRequest",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["data/technologies.js", "lib/matcher.js", "content/content.js"],
      "run_at": "document_idle"
    }
  ]
}
